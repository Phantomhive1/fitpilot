# ============================================================
# .env.example — 环境变量模板（提交到 git）
# 用法：
#   cp deploy/.env.example deploy/.env
#   vim deploy/.env   # 改下面这些值
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# ⚠️ .env 文件本身不要提交到 git（已在 .gitignore 里忽略）
# ============================================================

# ─────────────── MySQL ───────────────
# 数据库 root 密码（首次启动时 MySQL 会用这个建库）
MYSQL_ROOT_PASSWORD=ChangeThisToAStrongPassword!@#123
# 应用专用账号（生产不要用 root）
DB_NAME=fitpilot
DB_USER=fitpilot
DB_PASSWORD=AnotherStrongPassword!@#456

# ─────────────── 火山方舟（豆包）───────────────
# 1. 浏览器打开 https://console.volcengine.com/ark → API Key 管理 → 创建
# 2. 复制完整 key（格式 ark-xxxxxx-...，点眼睛图标显示完整再复制）
ARK_API_KEY=ark-REPLACE-WITH-YOUR-REAL-KEY
# 3. 模型广场 → 语言模型 → 找到豆包 → 详情页复制 Model ID
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-2-1-pro-260915
ARK_VISION_MODEL=doubao-seed-2-1-pro-260915

# ─────────────── 高德开放平台（外卖模式，选配）───────────────
# 申请：https://console.amap.com → 创建应用 → 添加 Key → 服务平台选「Web服务」
# 个人开发者认证后免费额度自用够用；不配置则「点外卖」模式不可用，其余功能不受影响
AMAP_KEY=