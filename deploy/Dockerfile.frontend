# ============================================================
# Frontend Dockerfile（多阶段构建）
# 用法（在 fitpilot-frontend 目录下）：
#   docker build -t fitpilot-frontend:1.0 -f ../deploy/Dockerfile.frontend .
# ============================================================

# ── 阶段 1: 构建 ─────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /build

# 国内镜像加速
RUN npm config set registry https://registry.npmmirror.com

COPY package*.json ./
RUN npm ci --no-audit --no-fund

# 恢复 AI 运行资产（模型 + wasm）：models/ 不进 git，从官方源下载
# 若构建机访问 storage.googleapis.com 不通，先本地跑 npm run prepare:assets
# 再 docker build（.dockerignore 未排除它们时会被 COPY 进来）
COPY scripts ./scripts
RUN npm run prepare:assets

COPY . .
RUN npm run build

# ── 阶段 2: nginx 静态托管 ─────────────────────────────
FROM nginx:1.27-alpine
COPY --from=builder /build/dist /usr/share/nginx/html
COPY ../deploy/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80